#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp BACKSPACE    &kp N0    &kp N4     &kp D     &kp F    &kp N0    &kp B     &kp P
                &mo 1            &kp N0    &kp N5     &kp O     &kp T    &kp N0    &kp L     &kp U
                &kp N9           &kp N0    &kp N6     &kp A     &kp E    &kp N0    &kp I     &kp S

                &kp N1   &kp N0   &kp Q     &kp W     &kp K    &kp N0   &kp M     &kp J
                &kp N2   &kp N0   &kp Y     &kp X     &kp Z    &kp N0   &kp R     &kp G
                &kp N3   &kp N0   &kp N     &kp V     &kp C    &kp N0   &kp SPACE &kp H
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans   &trans   &trans    &trans
                &trans        &trans        &trans        &trans        &trans   &trans   &trans    &trans
                &trans        &trans        &trans        &trans        &trans   &trans   &trans    &trans
                &trans        &trans        &trans        &trans        &trans   &trans   &trans    &trans
                &trans        &trans        &trans        &trans        &trans   &trans   &trans    &trans
                &trans        &trans        &trans        &trans        &trans   &trans   &trans    &trans
            >;
        };
    };
};
